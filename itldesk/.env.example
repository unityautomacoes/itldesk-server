# IP público ou domínio do seu servidor UnityDesk (ex.: acesso.suaempresa.com.br)
ITLDESK_HOST=acesso.suaempresa.com.br

# Chave secreta dos tokens de login do painel (gere com: openssl rand -hex 32)
ITLDESK_JWT_KEY=troque-por-uma-chave-aleatoria

# Exigir login (e assinatura ativa) para técnicos iniciarem acessos: Y ou N
ITLDESK_MUST_LOGIN=Y

# Mercado Pago (Suas integrações > Credenciais). Use TEST-... para testar.
MP_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (opcional, recomendado)
MP_WEBHOOK_SECRET=

# Dias de carência após o vencimento e dias de teste grátis
BILLING_GRACE_DAYS=5
BILLING_TRIAL_DAYS=7

# Site de vendas: trial = teste grátis no cadastro; pending = só libera após pagar
BILLING_SIGNUP_MODE=trial
# Contato exibido no site (WhatsApp só com números, ex.: 5511999999999)
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
