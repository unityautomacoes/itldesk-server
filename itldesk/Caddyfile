# ITLDesk - HTTPS automático (Let's Encrypt)
{$ITLDESK_HOST} {
	encode gzip
	# cobrança (/cobranca) e site de vendas (/, /assinar, /download, /termos)
	@billing path /cobranca* / /assinar* /download/* /termos
	handle @billing {
		reverse_proxy billing:8000
	}
	# painel técnico e API dos clientes ITLDesk
	handle {
		reverse_proxy api:21114
	}
}
